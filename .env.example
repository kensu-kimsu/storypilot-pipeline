# Azure Speech resource credentials (store actual values in secrets.json or .env)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Expressive English male MAI model; override with --voice if auditioning alternatives.
AZURE_TTS_VOICE=en-US-Ethan:MAI-Voice-2.1

# Choose "azure", "fish", or "chatterbox". Azure remains the default.
NARRATION_PROVIDER=azure
FISH_SPEECH_URL=http://127.0.0.1:8080

# For a stable narrator, provide either a saved Fish reference ID, or both a
# clean WAV sample and the exact transcript for that sample.
FISH_SPEECH_REFERENCE_ID=
FISH_SPEECH_REFERENCE_AUDIO=
FISH_SPEECH_REFERENCE_TEXT_FILE=

# Local Resemble AI Chatterbox bridge (no API key or per-character fee)
CHATTERBOX_URL=http://127.0.0.1:8090

# Social video experiments. Search uses YOUTUBE_API_KEY and OpenAI web search;
# yt-dlp downloads a selected public YouTube/TikTok candidate temporarily.
SOCIAL_VIDEO_SEARCHES_PER_RUN=10
SOCIAL_VIDEO_MAX_CANDIDATES=2
SOCIAL_VIDEO_MAX_DOWNLOAD_MB=250
SOCIAL_VIDEO_MAX_SOURCE_MINUTES=30

# Cost controls
# Each optional stage override uses the global OPENAI_MODEL when blank.
# Keep research, verification, and scripting on a model that passes your quality checks.
OPENAI_MODEL=
OPENAI_MODEL_IDEATION=
OPENAI_MODEL_RESEARCH=
OPENAI_MODEL_VERIFICATION=
OPENAI_MODEL_SCRIPT=
OPENAI_MODEL_METADATA=
OPENAI_MODEL_NEWS_SEARCH=
OPENAI_MODEL_SOCIAL_SEARCH=
OPENAI_MODEL_SOCIAL_RANKING=
OPENAI_MODEL_CLIP_ANALYSIS=

# Optional quality fallback for malformed JSON only. Set only after testing the chosen model.
OPENAI_MODEL_IDEATION_FALLBACK=
OPENAI_MODEL_RESEARCH_FALLBACK=
OPENAI_MODEL_VERIFICATION_FALLBACK=
OPENAI_MODEL_SCRIPT_FALLBACK=
OPENAI_MODEL_METADATA_FALLBACK=
OPENAI_MODEL_NEWS_SEARCH_FALLBACK=
OPENAI_MODEL_SOCIAL_RANKING_FALLBACK=

# Clear this to reuse valid stage checkpoints; set e.g. research,verification to force selected stages.
STORYPILOT_REFRESH_STAGES=
